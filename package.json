{
  "name": "kinetra-website",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "postinstall": "fumadocs-mdx",
    "build": "next build",
    "dev": "next dev --turbo",
    "start": "serve out -l 3000",
    "lint": "biome check",
    "fix": "biome check --fix",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "reset": "rimraf node_modules .next out .source"
  },
  "browserslist": {
    "production": [
      "defaults and fully supports es6-module",
      "> 0.5%",
      "not dead"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ],
    "ssr": [
      "maintained node versions"
    ]
  },
  "dependencies": {
    "@c15t/nextjs": "3.1.0",
    "@c15t/scripts": "3.0.1",
    "@plausible-analytics/tracker": "0.4.6",
    "@radix-ui/react-hover-card": "1.2.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tooltip": "1.4.1",
    "class-variance-authority": "0.7.1",
    "fumadocs-core": "16.17.7",
    "fumadocs-mdx": "15.4.8",
    "fumadocs-ui": "16.17.7",
    "lucide-react": "1.59.0",
    "mermaid": "12.2.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-medium-image-zoom": "5.4.9",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.31",
    "rimraf": "6.1.3",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
